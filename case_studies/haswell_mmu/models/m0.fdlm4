# Reflects mental model used in IISWC paper (i.e. no prefetching, walk merging, or
# bypassing). This assumes that a PML4E cache does not exist.

ACTIONS {
    # TLBs
    LookupDtlb;
    LookupStlb;

    # Page table walk
    InitiateWalk;

    # Paging structure caches and CR3
    LookupPdeCache;
    LookupPdpteCache;
    LookupCr3;

    # Page miss handler memory accesses
    PmhPml4eLookup;
    PmhPdpteLookup;
    PmhPdeLookup;
    PmhPteLookup;

    # Op flow
    OpSquash;
    OpRetirement;
}

COUNTER_GROUPS {
    dtlb_load_misses.stlb_hit :
        dtlb_load_misses.stlb_hit_4k,
        dtlb_load_misses.stlb_hit_2m;

    dtlb_store_misses.stlb_hit :
        dtlb_store_misses.stlb_hit_4k,
        dtlb_store_misses.stlb_hit_2m;

    dtlb_load_misses.walk_completed :
        dtlb_load_misses.walk_completed_4k,
        dtlb_load_misses.walk_completed_2m_4m,
        dtlb_load_misses.walk_completed_1g;

    dtlb_store_misses.walk_completed :
        dtlb_store_misses.walk_completed_4k,
        dtlb_store_misses.walk_completed_2m_4m,
        dtlb_store_misses.walk_completed_1g;
}

FLOW {
    # Assume a load or store micro-op that is seeking address translation

    # Lookup DTLB
    do LookupDtlb;

    switch DtlbLookupStatus {
        Hit => next dtlb_hit;
        Miss => next dtlb_miss;
    };

dtlb_hit:
    # Enumerate the allowed combinations for the DTLB
    switch AccessType {
        Load =>
            switch PageSize {
                KB4 => pass;
                MB2 => pass;
                GB1 => pass;
            };
        Store =>
            switch PageSize {
                KB4 => pass;
                MB2 => pass;
                GB1 => pass;
            };
    };

    next end_of_op_lifetime;

dtlb_miss:
    # A DTLB miss has occured

    # Look up the STLB
    do LookupStlb;
    switch StlbLookupStatus {
        Hit => next stlb_hit;
        Miss => next stlb_miss;
    };

stlb_hit:
    # The micro-op hits the STLB
    switch AccessType {
        Load =>
            switch PageSize {
                KB4 => incr dtlb_load_misses.stlb_hit_4k;
                MB2 => incr dtlb_load_misses.stlb_hit_2m;
            };
            incr dtlb_load_misses.stlb_hit;
            next end_of_op_lifetime;
        Store =>
            switch PageSize {
                KB4 => incr dtlb_store_misses.stlb_hit_4k;
                MB2 => incr dtlb_store_misses.stlb_hit_2m;
            };
            incr dtlb_store_misses.stlb_hit;
            next end_of_op_lifetime;
    };

stlb_miss:

    # Assume that every STLB miss causes a page table walk
    do InitiateWalk;

    # Increment the "miss causes a walk" counters
    switch AccessType {
        Load => incr dtlb_load_misses.miss_causes_a_walk;
        Store => incr dtlb_store_misses.miss_causes_a_walk;
    };

    # Assume a 4-level page table walk with PDE and PDPTE paging structure caches.

    # Look up the paging structure caches

    # PDE cache
    do LookupPdeCache;
ifdef(`PSC_COUNTERS',`    switch AccessType {
        Load  => incr dtlb_load_misses.pde_cache_lookup;
        Store => incr dtlb_store_misses.pde_cache_lookup;
    };')
    switch PdeCacheLookupStatus {
        Hit => next lookup_pte;
        Miss => pass;
    };

    # PDE cache miss
    switch AccessType {
        Load  => incr dtlb_load_misses.pde_cache_miss;
        Store => incr dtlb_store_misses.pde_cache_miss;
    };

    # PDPTE cache
    do LookupPdpteCache;
ifdef(`PSC_COUNTERS',`    switch AccessType {
        Load  => incr dtlb_load_misses.pdpte_cache_lookup;
        Store => incr dtlb_store_misses.pdpte_cache_lookup;
    };')
    switch PdpteCacheLookupStatus {
        Hit => next lookup_pde;
        Miss => pass;
    };

ifdef(`PSC_COUNTERS',`    # PDPTE cache miss
    switch AccessType {
        Load  => incr dtlb_load_misses.pdpte_cache_miss;
        Store => incr dtlb_store_misses.pdpte_cache_miss;
    };
')
    # No PML4E cache

    # Look up CR3
    do LookupCr3;

lookup_pml4e:
    # Look up PML4E in memory hierarchy
    do PmhPml4eLookup;
    incr page_walker_loads;

    # The PML4E is either valid or invalid (leaf is not allowed)
    switch Pml4eStatus {
        NotLeaf => pass;
        Invalid =>
            do OpSquash; # assume squashed ops never retire
            done;
    };

lookup_pdpte:
    # Look up PDPTE in memory hierarchy
    do PmhPdpteLookup;
    incr page_walker_loads;

    switch PdpteStatus {
        Leaf =>
            switch AccessType {
                Load =>
                    incr dtlb_load_misses.walk_completed_1g;
                    incr dtlb_load_misses.walk_completed;
                Store =>
                    incr dtlb_store_misses.walk_completed_1g;
                    incr dtlb_store_misses.walk_completed;
            };
            next end_of_op_lifetime;
        NotLeaf =>
            pass;
        Invalid =>
            do OpSquash; # assume squashed ops never retire
            done;
    };

lookup_pde:
    # Look up PDE in memory hierarchy
    do PmhPdeLookup;
    incr page_walker_loads;

    switch PdeStatus {
        Leaf =>
            switch AccessType {
                Load =>
                    incr dtlb_load_misses.walk_completed_2m_4m;
                    incr dtlb_load_misses.walk_completed;
                Store =>
                    incr dtlb_store_misses.walk_completed_2m_4m;
                    incr dtlb_store_misses.walk_completed;
            };
            next end_of_op_lifetime;
        NotLeaf =>
            pass;
        Invalid =>
            do OpSquash; # assume squashed ops never retire
            done;
    };

lookup_pte:
    # Look up PTE in memory hierarchy
    do PmhPteLookup;
    incr page_walker_loads;

    switch PteStatus {
        Leaf =>
            switch AccessType {
                Load =>
                    incr dtlb_load_misses.walk_completed_4k;
                    incr dtlb_load_misses.walk_completed;
                Store =>
                    incr dtlb_store_misses.walk_completed_4k;
                    incr dtlb_store_misses.walk_completed;
            };
            next end_of_op_lifetime;
        Invalid =>
            do OpSquash; # assume squashed ops never retire
            done;
    };

end_of_op_lifetime:
    # The micro-op is no longer live; either because it retires or because it is squashed
    switch OpRetires {
        No =>
            do OpSquash;
            done;
        Yes =>
            do OpRetirement;
            pass;
    };

op_retirement:
    # The micro-op is at the end of the ROB and retires here

    # Increment the STLB miss counters only if the micro-op misses both the DTLB and the
    # STLB
    switch DtlbLookupStatus {
        Hit => pass;
        Miss =>
            switch StlbLookupStatus {
                Hit => pass;
                Miss =>
                    switch AccessType {
                        Load => incr mem_uops_retired.stlb_miss_loads;
                        Store => incr mem_uops_retired.stlb_miss_stores;
                    };
            };
    };

    # Always increment the retired uop counters
    switch AccessType {
        Load => incr mem_uops_retired.all_loads;
        Store => incr mem_uops_retired.all_stores;
    };

    # Finish
    done;
}
