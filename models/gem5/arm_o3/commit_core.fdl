# Source population: one committed dynamic uop.
# Counted events: committed uops, instruction boundaries, control uops, and memory op classes.
# Not modeled: timing, squashes, frontend fetch, backend issue, cache behavior, and PMU groups.

FLOW {
    incr committed_uops;
    switch op_class {
        int_alu =>
            incr committed_int_alu;
        int_mult =>
            incr committed_int_mult;
        int_div =>
            incr committed_int_div;
        float_add =>
            incr committed_float_add;
        mem_read =>
            incr committed_mem_read;
        mem_write =>
            incr committed_mem_write;
        float_mem_read =>
            incr committed_float_mem_read;
        float_mem_write =>
            incr committed_float_mem_write;
        simd_alu =>
            incr committed_simd_alu;
        other =>
            pass;
    };
    switch control {
        yes =>
            incr committed_control;
        no =>
            pass;
    };
    switch instruction_boundary {
        yes =>
            incr committed_instructions;
        no =>
            pass;
    };
    done;
}
