      "path": "src/arch/arm/tlb.cc",
      "symbol": "TLB::TlbStats::TlbStats",
      "snippets": [
        "ADD_STAT(instHits, statistics::units::Count::get(), \"Inst hits\")",
        "ADD_STAT(instMisses, statistics::units::Count::get(), \"Inst misses\")",
        "ADD_STAT(readHits, statistics::units::Count::get(), \"Read hits\")",
        "ADD_STAT(readMisses, statistics::units::Count::get(),  \"Read misses\")",
        "ADD_STAT(writeHits, statistics::units::Count::get(), \"Write hits\")",
        "ADD_STAT(writeMisses, statistics::units::Count::get(), \"Write misses\")",
        "ADD_STAT(inserts, statistics::units::Count::get(), \"Number of times an entry is inserted into the TLB\")",
        "ADD_STAT(readAccesses, statistics::units::Count::get(), \"Read accesses\",\n             readHits + readMisses)",
        "ADD_STAT(writeAccesses, statistics::units::Count::get(), \"Write accesses\",\n             writeHits + writeMisses)",
        "ADD_STAT(instAccesses, statistics::units::Count::get(), \"Inst accesses\",\n             instHits + instMisses)",
        "ADD_STAT(misses, statistics::units::Count::get(),\n             \"Total TLB (inst and data) misses\",\n             readMisses + writeMisses + instMisses)",
        "ADD_STAT(accesses, statistics::units::Count::get(),\n             \"Total TLB (inst and data) accesses\",\n             readAccesses + writeAccesses + instAccesses)"
      ]
    },
    "tlb_miss_increment": {
      "path": "src/arch/arm/tlb.cc",
      "symbol": "TLB::lookup",
      "snippets": [
        "if (!retval) {\n            if (mode == BaseMMU::Execute) {\n                stats.instMisses++;\n            } else if (mode == BaseMMU::Write) {\n                stats.writeMisses++;\n            } else {\n                stats.readMisses++;\n            }\n        }"
      ]
    }
