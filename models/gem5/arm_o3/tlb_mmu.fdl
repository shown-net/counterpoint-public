# Source population: one Arm TLB lookup counted by gem5 TLB stats.
# Counted events: aggregate DTLB/ITLB accesses and misses, plus DTLB read/write and ITLB instruction splits.
# Not modeled: walk depth, stage-2 translation, shared L2 TLB split, timing, PMU groups, and canonical metrics.

FLOW {
    switch lookup_class {
        dtlb_read_hit =>
            incr dtlb_accesses;
            incr dtlb_read_accesses;
            incr dtlb_read_hits;
        dtlb_read_miss =>
            incr dtlb_accesses;
            incr dtlb_misses;
            incr dtlb_read_accesses;
            incr dtlb_read_misses;
        dtlb_write_hit =>
            incr dtlb_accesses;
            incr dtlb_write_accesses;
            incr dtlb_write_hits;
        dtlb_write_miss =>
            incr dtlb_accesses;
            incr dtlb_misses;
            incr dtlb_write_accesses;
            incr dtlb_write_misses;
        itlb_inst_hit =>
            incr itlb_accesses;
            incr itlb_inst_accesses;
            incr itlb_inst_hits;
        itlb_inst_miss =>
            incr itlb_accesses;
            incr itlb_misses;
            incr itlb_inst_accesses;
            incr itlb_inst_misses;
        dtlb_insert =>
            incr dtlb_inserts;
        itlb_insert =>
            incr itlb_inserts;
    };
    done;
}
