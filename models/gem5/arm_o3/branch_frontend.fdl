# Source population: one committed control instruction.
# Counted events: committed control instructions and branch-predictor committed mispredicts.
# Not modeled: predictor internals, target class, frontend timing, PMU groups, and canonical metrics.

FLOW {
    incr committed_branches;
    switch prediction {
        correct =>
            pass;
        mispredicted =>
            incr branch_mispredicts;
    };
    switch conditional_prediction {
        predicted_correct =>
            incr cond_predicted;
        predicted_incorrect =>
            incr cond_predicted;
            incr cond_incorrect;
        other =>
            pass;
    };
    switch btb_activity {
        hit =>
            incr btb_lookups;
            incr btb_hits;
        miss =>
            incr btb_lookups;
        mispredicted =>
            incr btb_lookups;
            incr btb_mispredicted;
        other =>
            pass;
    };
    done;
}
